---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import UploadSection from '../components/UploadSection.astro';
import AnalyticsSection from '../components/AnalyticsSection.astro';
import AiSection from '../components/AiSection.astro';
import MonetizeSection from '../components/MonetizeSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import PricingSection from '../components/PricingSection.astro';
import PlatformsSection from '../components/PlatformsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaSection from '../components/CtaSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Flightcast Pricing | Video Podcast Hosting Platform">
  <div class="landing __variable_245d8d __variable_1b5fad font-sans antialiased">
    <main class="landing bg-background text-foreground">
      <Header />
      <Hero />
      <UploadSection />
      <AnalyticsSection />
      <AiSection />
      <MonetizeSection />
      <TestimonialsSection />
      <PricingSection />
      <PlatformsSection />
      <FaqSection />
      <CtaSection />
      <Footer />
    </main>
  </div>
</Layout>
